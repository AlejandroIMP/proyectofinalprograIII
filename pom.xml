<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>umg.edu.gt</groupId>
    <artifactId>proyectofinal1</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <javafx.version>25</javafx.version>
    </properties>

    <dependencies>
        <!-- JavaFX (interfaz gráfica de la sección 2) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Oracle JDBC driver (sección 3 - pipeline de carga desde la BD) -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>23.3.0.23.09</version>
        </dependency>

        <!-- Apache POI (sección 4 - generación de reportes en Microsoft Word .docx) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- Failsafe: corre los *IT.java en la fase 'verify' (no en 'test') -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.2.5</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- JaCoCo: cobertura HTML en target/site/jacoco/index.html tras 'verify' -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <!-- Por defecto la demo CLI. Para la GUI usar:
                         mvn exec:java -Dexec.mainClass=umg.edu.gt.floristeria.ui.HashTableLauncher
                         o bien:  mvn javafx:run -->
                    <mainClass>umg.edu.gt.floristeria.Main</mainClass>
                </configuration>
            </plugin>
            <!-- JavaFX runtime: mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>umg.edu.gt.floristeria.ui.HashTableApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>


    <!-- ================================================================
         Perfil: dbfloristeria
         Activa la conexión Oracle real con las credenciales de la VM UMG.
         Uso NetBeans : clic derecho proyecto → Set Configuration → dbfloristeria
         Uso terminal : mvn exec:java -Pdbfloristeria
         Uso GUI      : mvn javafx:run -Pdbfloristeria
         ================================================================ -->
    <profiles>
        <profile>
            <id>dbfloristeria</id>

            <!-- Propiedades del perfil: disponibles como -D en cualquier plugin -->
            <properties>
                <oracle.url>localhost:1521/umg</oracle.url>
                <oracle.user>system</oracle.user>
                <!-- El símbolo $ en XML no necesita escape, pero lo ponemos
                     explícito para evitar que Maven lo interprete como propiedad -->
                <oracle.pass>Umg&#36;2026</oracle.pass>
            </properties>

            <build>
                <plugins>
                    <!-- exec:java — demo CLI con Oracle -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.3.0</version>
                        <configuration>
                            <mainClass>umg.edu.gt.floristeria.Main</mainClass>
                            <environmentVariables>
                                <ORACLE_URL>${oracle.url}</ORACLE_URL>
                                <ORACLE_USER>${oracle.user}</ORACLE_USER>
                                <ORACLE_PASS>${oracle.pass}</ORACLE_PASS>
                            </environmentVariables>
                        </configuration>
                    </plugin>
                    <!-- Failsafe con credenciales Oracle: activa los IT en 'mvn verify -Pdbfloristeria' -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.2.5</version>
                        <configuration>
                            <environmentVariables>
                                <ORACLE_URL>${oracle.url}</ORACLE_URL>
                                <ORACLE_USER>${oracle.user}</ORACLE_USER>
                                <ORACLE_PASS>${oracle.pass}</ORACLE_PASS>
                            </environmentVariables>
                        </configuration>
                    </plugin>
                    <!-- javafx:run — GUI con Oracle -->
                    <plugin>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-maven-plugin</artifactId>
                        <version>0.0.8</version>
                        <configuration>
                            <mainClass>umg.edu.gt.floristeria.ui.HashTableApp</mainClass>
                            <options>
                                <option>-DORACLE_URL=${oracle.url}</option>
                                <option>-DORACLE_USER=${oracle.user}</option>
                                <option>-DORACLE_PASS=${oracle.pass}</option>
                            </options>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
