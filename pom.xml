<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>umg.edu.gt</groupId>
    <artifactId>proyectofinal1</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <javafx.version>25</javafx.version>
    </properties>

    <dependencies>
        <!-- JavaFX (interfaz gráfica de la sección 2) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Oracle JDBC driver (sección 3 - pipeline de carga desde la BD) -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>23.3.0.23.09</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <!-- Por defecto la demo CLI. Para la GUI usar:
                         mvn exec:java -Dexec.mainClass=umg.edu.gt.floristeria.ui.HashTableLauncher
                         o bien:  mvn javafx:run -->
                    <mainClass>umg.edu.gt.floristeria.Main</mainClass>
                </configuration>
            </plugin>
            <!-- JavaFX runtime: mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>umg.edu.gt.floristeria.ui.HashTableApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>


    <!-- ================================================================
         Perfil: dbfloristeria
         Activa la conexión Oracle real con las credenciales de la VM UMG.
         Uso NetBeans : clic derecho proyecto → Set Configuration → dbfloristeria
         Uso terminal : mvn exec:java -Pdbfloristeria
         ================================================================ -->
    <profiles>
        <profile>
            <id>dbfloristeria</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.3.0</version>
                        <configuration>
                            <mainClass>umg.edu.gt.floristeria.Main</mainClass>
                            <environmentVariables>
                                <ORACLE_URL>jdbc:oracle:thin:@//localhost:1521/umg</ORACLE_URL>
                                <ORACLE_USER>system</ORACLE_USER>
                                <ORACLE_PASS>Umg$2026</ORACLE_PASS>
                            </environmentVariables>
                        </configuration>
                    </plugin>
                    <!-- JavaFX también hereda las variables al usar mvn javafx:run -Pdbfloristeria -->
                    <plugin>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-maven-plugin</artifactId>
                        <version>0.0.8</version>
                        <configuration>
                            <mainClass>umg.edu.gt.floristeria.ui.HashTableApp</mainClass>
                            <options>
                                <option>-DORACLE_URL=jdbc:oracle:thin:@//localhost:1521/umg</option>
                                <option>-DORACLE_USER=system</option>
                                <option>-DORACLE_PASS=Umg$2026</option>
                            </options>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
